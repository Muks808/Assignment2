@model RaceEditor
@{ ViewData["Title"] = Model.Id == 0 ? "Create event" : "Edit event"; }
<a asp-action="Index">← Organiser dashboard</a>
<h1>@ViewData["Title"]</h1>
@if (Model.Categories.Length == 0)
{
    <form asp-action="AddCategory" method="post" class="panel inline">
        <label>First category <input name="CategoryName" placeholder="Open 10 km" required></label>
        <label>Description <input name="Description" required></label>
        <button>Create category</button>
    </form>
}
<section class="panel">
    @if (Model.BannerUrl is not null)
    {
        <img class="banner wide" src="@Url.Action("Image", "Races", new { kind = "banner", id = Model.Id })" alt="Current event banner">
    }
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="stack">
        <div asp-validation-summary="All" class="validation"></div>
        <label asp-for="Fields.EventName">Event name</label><input asp-for="Fields.EventName" required>
        <label asp-for="Fields.Description">Description</label><textarea asp-for="Fields.Description" rows="4" required></textarea>
        <label asp-for="Fields.EventDate">Event date</label><input asp-for="Fields.EventDate" type="date" required>
        <label asp-for="Fields.StartTime">Start time (hh:mm:ss)</label><input asp-for="Fields.StartTime" required>
        <label asp-for="Fields.Province">Province</label><input asp-for="Fields.Province" required>
        <label asp-for="Fields.EntryFee">Entry fee (R)</label><input asp-for="Fields.EntryFee" type="number" min="0" step="0.01">
        <label asp-for="Fields.MaxParticipants">Capacity</label><input asp-for="Fields.MaxParticipants" type="number" min="1">
        <label asp-for="Fields.CategoryID">Primary category</label>
        <select asp-for="Fields.CategoryID" required>
            <option value="">Select a category</option>
            @foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }
        </select>
        <label asp-for="Fields.Location">Location</label><input asp-for="Fields.Location" required>
        <label asp-for="Fields.DistanceKm">Distance (km)</label><input asp-for="Fields.DistanceKm" type="number" step="0.01" min="0.1" max="1000" required>
        <label asp-for="Fields.EventType">Event type</label>
        <select asp-for="Fields.EventType"><option>Run</option><option>Walk</option><option>Cycle</option></select>
        <label for="banner">Event banner (PNG or JPEG, up to 5 MB)</label><input id="banner" name="banner" type="file" accept="image/jpeg,image/png">
        <button>Save event</button>
    </form>
</section>
